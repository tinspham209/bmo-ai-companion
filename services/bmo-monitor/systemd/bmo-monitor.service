[Unit]
Description=BMO System Monitor
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bmo-ai-companion/services/bmo-monitor
ExecStart=/opt/bmo-ai-companion/services/bmo-monitor/.venv/bin/python main.py
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
